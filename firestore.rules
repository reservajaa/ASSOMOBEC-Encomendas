rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read for residents and packages
    // Allow write only for authenticated users (admins)
    match /residents/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /packages/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
